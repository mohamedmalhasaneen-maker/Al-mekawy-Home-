{
  "entities": {
    "Quote": {
      "title": "Quote",
      "description": "Saved customer quotation for Al-Mekawy Home UPVC windows & doors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the quote" },
        "name": { "type": "string", "description": "Name/label of the saved quote" },
        "customer": {
          "type": "object",
          "description": "Customer info",
          "properties": {
            "name": { "type": "string" },
            "phone": { "type": "string" },
            "address": { "type": "string" },
            "notes": { "type": "string" }
          }
        },
        "items": {
          "type": "array",
          "description": "List of window/door quote items",
          "items": { "type": "object" }
        },
        "totalPrice": { "type": "number", "description": "Calculated total price in EGP" },
        "discountPercentage": { "type": "number", "description": "Discount percentage applied" },
        "date": { "type": "string", "description": "Formatted date string" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "name", "items", "totalPrice"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Saved customer profile for quick access and reuse across quotes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique customer ID" },
        "name": { "type": "string", "description": "Customer full name" },
        "phone": { "type": "string", "description": "Customer primary contact phone" },
        "address": { "type": "string", "description": "Customer location or project site address" },
        "notes": { "type": "string", "description": "General customer notes or preferences" },
        "createdAt": { "type": "string", "description": "Registration date timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "phone"]
    }
  },
  "firestore": {
    "/quotes/{quoteId}": {
      "entity": "Quote",
      "description": "Stored quotations for the company"
    },
    "/customers/{customerId}": {
      "entity": "Customer",
      "description": "Registered customer profiles directory"
    }
  }
}
